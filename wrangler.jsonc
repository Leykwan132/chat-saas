{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilobot",
  "compatibility_date": "2026-06-20",
  "observability": {
    "enabled": true
  },
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
