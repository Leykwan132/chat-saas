{
    "authKit": {
      "dev": {
        "configure": {
          "redirectUris": ["https://kilobot.app/callback"],
          "appHomepageUrl": "https://kilobot.app",
          "corsOrigins": ["https://kilobot.app"]
        },
        "localEnvVars": {
          "VITE_WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
          "VITE_WORKOS_REDIRECT_URI": "https://kilobot.app/callback"
        }
      },
      "preview": {
        "configure": {
          "redirectUris": ["https://${buildEnv.VERCEL_BRANCH_URL}/callback"],
          "appHomepageUrl": "https://${buildEnv.VERCEL_PROJECT_PRODUCTION_URL}",
          "corsOrigins": ["https://${buildEnv.VERCEL_BRANCH_URL}"]
        }
      },
      "prod": {
        "configure": {
          "redirectUris": ["https://kilobot.app/callback"],
          "appHomepageUrl": "https://kilobot.app",
          "corsOrigins": ["https://kilobot.app"]
        }
      }
    }
  }