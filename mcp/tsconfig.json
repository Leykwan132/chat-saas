{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
    "../worker/integrations/**/*.ts",
    "../shared/integrations/**/*.ts"
  ],
  "exclude": [
    "./**/*.test.ts",
    "../shared/integrations/**/*.test.ts",
    "../worker/integrations/**/*.test.ts"
  ]
}
